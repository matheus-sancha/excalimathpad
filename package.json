{
  "name": "excalimathpad",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:web && npm run build:plugin",
    "build:web": "vite build",
    "build:plugin": "node esbuild.plugin.mjs",
    "lint": "oxlint && eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "audit:plugin": "node scripts/audit-plugin.mjs",
    "test:blocked": "node scripts/blocked-run.mjs",
    "test:popout": "node scripts/popout-run.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run audit:plugin && npm run test:blocked && npm run test:popout",
    "version": "node scripts/version.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@observablehq/plot": "0.6.17",
    "katex": "^0.16.47",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.1.3",
    "obsidian": "1.14.4",
    "oxlint": "^1.88.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  }
}
